{
    "name": "modern-portfolio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
          "dev": "next dev",
          "build": "next build",
          "start": "next start",
          "lint": "next lint",
          "format": "prettier --write .",
          "format:check": "prettier --check .",
          "prepare": "husky"
    },
    "dependencies": {
          "autoprefixer": "10.4.14",
          "eslint": "8.37.0",
          "eslint-config-next": "13.3.0",
          "framer-motion": "^10.11.2",
          "next": "13.3.0",
          "postcss": "8.4.21",
          "react": "18.2.0",
          "react-dom": "18.2.0",
          "tailwindcss": "3.3.1"
    },
    "devDependencies": {
          "@types/node": "^25.6.0",
          "@types/react": "~18.3",
          "@types/react-dom": "~18.3",
          "@typescript-eslint/eslint-plugin": "^6.21.0",
          "@typescript-eslint/parser": "^6.21.0",
          "eslint-config-prettier": "^9.1.0",
          "husky": "^9.1.7",
          "lint-staged": "^15.3.0",
          "prettier": "^3.4.2",
          "sharp": "^0.34.5",
          "typescript": "~5.4"
    },
    "lint-staged": {
          "*.{ts,tsx,js,jsx}": [
                  "eslint --fix",
                  "prettier --write"
          ],
          "*.{json,md,css}": [
                  "prettier --write"
          ]
    }
}
